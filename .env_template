ENV_SECRET_KEY # Секретный ключ для веб приложения
DATABASE_NAME # Название базы данных
DATABASE_USER # Логин пользователя
DATABASE_PASSWORD # Пароль пользователя
DATABASE_HOST # Хост БД
DATABASE_PORT # Порт БД
PUBLIC_API_KEY_STRIPE # Публичный API ключ сервиса STRIPE
CELERY_BROKER_URL # URL брокера сообщений redis
CELERY_RESULT_BACKEND # URL брокера сообщений redis
EMAIL_HOST # Почта адрес хоста
EMAIL_PORT # Почта порт хоста
EMAIL_HOST_USER # Почта логин пользователя
EMAIL_HOST_PASSWORD # Почта пароль пользователя
EMAIL_USE_TLS # Почта TLS передача
EMAIL_USE_SSL # Почта SSL передача